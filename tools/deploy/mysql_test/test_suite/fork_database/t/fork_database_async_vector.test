##owner: fanxingkun.fxk
##owner group: 底层引擎部-轻量版
##description: Fork Database与异步向量索引正交适配测试
##tags: fork_database async_index vector_index hnsw
##author: fanxingkun.fxk
#
# Verifies that FORK DATABASE on a database containing tables with async
# HNSW vector indexes produces consistent results where all main-table
# rows are searchable via the index in the forked database.
#
# Root cause of the bug:
#   Fork Database obtains a global snapshot for all tables. Async index
#   auxiliary tables (vector_index_log) have commit versions strictly
#   higher than the main table for the same logical data, because
#   ChangeStream processes DML asynchronously in separate transactions.
#   When both main table and auxiliary table are forked at the same
#   fork_snapshot_version, the auxiliary table misses data whose
#   ChangeStream commit hasn't happened yet.
#
# Expected failure before fix:
#   fork_approx < fork_total  (async index is incomplete on forked table)
#
# Expected pass after fix:
#   fork_approx == fork_total (fork database waits for ChangeStream
#   before obtaining the global snapshot)

--disable_warnings
drop database if exists db_async_src;
drop database if exists db_async_fork;
--enable_warnings

connect (obsys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connection default;

SET wait_timeout=30000000;
SET ob_trx_timeout = 100000000;
SET ob_query_timeout = 100000000;

alter system set ob_vector_memory_limit_percentage = 20;
sleep 3;

#########################################################################
--echo ============================================
--echo 1. Fork Database: async HNSW table consistency
--echo ============================================
#########################################################################

create database db_async_src;
use db_async_src;

--echo # Create table with async HNSW vector index
create table t_vec(
  c1 int primary key,
  c2 vector(3),
  vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;

--echo # Insert initial rows and refresh so ChangeStream catches up
insert into t_vec values(1, '[1.0, 1.0, 1.0]');
insert into t_vec values(2, '[2.0, 2.0, 2.0]');
insert into t_vec values(3, '[3.0, 3.0, 3.0]');
insert into t_vec values(4, '[4.0, 4.0, 4.0]');
insert into t_vec values(5, '[5.0, 5.0, 5.0]');

call dbms_index_manager.refresh();

--echo # Verify initial 5 rows are indexed
select count(*) as cnt from (
  select c1 from t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 100
) t;

--echo # Insert 95 more rows WITHOUT refresh - ChangeStream has NOT caught up
--disable_query_log
begin;
let $i = 6;
while ($i <= 100) {
  eval insert into t_vec values($i, '[$i.0, $i.0, $i.0]');
  inc $i;
}
commit;
--enable_query_log

--echo # Fork database immediately - before ChangeStream finishes
fork database db_async_src to db_async_fork;
let $wait_timeout = 120;
--source mysql_test/test_suite/fork_database/include/wait_fork_database.inc

--echo # Refresh source so it catches up (does NOT help already-forked data)
call dbms_index_manager.refresh();

--echo # Source: direct count
select count(*) as src_total from db_async_src.t_vec;

--echo # Fork: direct count (main table - always complete)
select count(*) as fork_total from db_async_fork.t_vec;

--echo # Fork: approximate search (reads async index)
--echo # EXPECTED after fix: 100 (equals fork_total)
--echo # BUG before fix: < 100 (vector_index_log incomplete in fork)
select count(*) as fork_approx from (
  select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 200
) t;

--echo # Verify fork main table data is intact
select c1, c2 from db_async_fork.t_vec where c1 in (1, 50, 100) order by c1;

--disable_warnings
drop database if exists db_async_src;
drop database if exists db_async_fork;
--enable_warnings

#########################################################################
--echo ============================================
--echo 2. Fork Database: mixed tables (async vector + regular)
--echo ============================================
#########################################################################
# This test verifies that fork database handles a database containing
# BOTH async-indexed tables and regular tables correctly.

create database db_async_src;
use db_async_src;

--echo # Create regular table (no async index)
create table t_regular(
  id int primary key,
  name varchar(50),
  index idx_name(name)
);

--echo # Create async HNSW table
create table t_vec(
  c1 int primary key,
  c2 vector(3),
  vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;

--echo # Insert data into both tables
insert into t_regular values (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

--disable_query_log
let $i = 1;
while ($i <= 50) {
  eval insert into t_vec values($i, '[$i.0, $i.0, $i.0]');
  inc $i;
}
--enable_query_log

--echo # Do NOT refresh - ChangeStream behind for t_vec
--echo # Fork database with mixed tables
fork database db_async_src to db_async_fork;
let $wait_timeout = 120;
--source mysql_test/test_suite/fork_database/include/wait_fork_database.inc

call dbms_index_manager.refresh();

--echo # Verify regular table is fully consistent (unaffected by async index issue)
select count(*) as fork_regular_cnt from db_async_fork.t_regular;
select * from db_async_fork.t_regular order by id;

--echo # Verify async vector table: direct count
select count(*) as fork_vec_total from db_async_fork.t_vec;

--echo # Verify async vector table: approximate search
--echo # EXPECTED after fix: 50 (equals fork_vec_total)
--echo # BUG before fix: < 50
select count(*) as fork_vec_approx from (
  select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 100
) t;

--disable_warnings
drop database if exists db_async_src;
drop database if exists db_async_fork;
--enable_warnings

#########################################################################
--echo ============================================
--echo 3. Control: Fork Database after full refresh
--echo ============================================
#########################################################################
# Control group: if ChangeStream is fully caught up before fork,
# the result should be consistent even without the fix.

create database db_async_src;
use db_async_src;

create table t_vec(
  c1 int primary key,
  c2 vector(3),
  vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;

--disable_query_log
let $i = 1;
while ($i <= 20) {
  eval insert into t_vec values($i, '[$i.0, $i.0, $i.0]');
  inc $i;
}
--enable_query_log

--echo # Refresh BEFORE fork - ChangeStream fully caught up
call dbms_index_manager.refresh();

--echo # Verify source consistency
select count(*) as src_total from t_vec;
select count(*) as src_approx from (
  select c1 from t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 50
) t;

--echo # Fork after refresh
fork database db_async_src to db_async_fork;
let $wait_timeout = 120;
--source mysql_test/test_suite/fork_database/include/wait_fork_database.inc

--echo # Fork should be fully consistent
select count(*) as fork_total from db_async_fork.t_vec;
select count(*) as fork_approx from (
  select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 50
) t;

#########################################################################
--echo ============================================
--echo Cleanup
--echo ============================================
#########################################################################

--disable_warnings
drop database if exists db_async_src;
drop database if exists db_async_fork;
--enable_warnings
alter system set ob_vector_memory_limit_percentage = 0;
