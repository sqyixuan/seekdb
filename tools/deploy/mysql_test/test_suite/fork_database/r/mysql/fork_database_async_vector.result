drop database if exists db_async_src;
drop database if exists db_async_fork;
SET wait_timeout=30000000;
SET ob_trx_timeout = 100000000;
SET ob_query_timeout = 100000000;
alter system set ob_vector_memory_limit_percentage = 20;
============================================
1. Fork Database: async HNSW table consistency
============================================
create database db_async_src;
use db_async_src;
# Create table with async HNSW vector index
create table t_vec(
c1 int primary key,
c2 vector(3),
vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;
# Insert initial rows and refresh so ChangeStream catches up
insert into t_vec values(1, '[1.0, 1.0, 1.0]');
insert into t_vec values(2, '[2.0, 2.0, 2.0]');
insert into t_vec values(3, '[3.0, 3.0, 3.0]');
insert into t_vec values(4, '[4.0, 4.0, 4.0]');
insert into t_vec values(5, '[5.0, 5.0, 5.0]');
call dbms_index_manager.refresh();
# Verify initial 5 rows are indexed
select count(*) as cnt from (
select c1 from t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 100
) t;
cnt
5
# Insert 95 more rows WITHOUT refresh - ChangeStream has NOT caught up
# Fork database immediately - before ChangeStream finishes
fork database db_async_src to db_async_fork;
# Refresh source so it catches up (does NOT help already-forked data)
call dbms_index_manager.refresh();
# Source: direct count
select count(*) as src_total from db_async_src.t_vec;
src_total
100
# Fork: direct count (main table - always complete)
select count(*) as fork_total from db_async_fork.t_vec;
fork_total
100
# Fork: approximate search (reads async index)
# EXPECTED after fix: 100 (equals fork_total)
# BUG before fix: < 100 (vector_index_log incomplete in fork)
select count(*) as fork_approx from (
select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 200
) t;
fork_approx
100
# Verify fork main table data is intact
select c1, c2 from db_async_fork.t_vec where c1 in (1, 50, 100) order by c1;
c1	c2
1	[1,1,1]
50	[50,50,50]
100	[100,100,100]
drop database if exists db_async_src;
drop database if exists db_async_fork;
============================================
2. Fork Database: mixed tables (async vector + regular)
============================================
create database db_async_src;
use db_async_src;
# Create regular table (no async index)
create table t_regular(
id int primary key,
name varchar(50),
index idx_name(name)
);
# Create async HNSW table
create table t_vec(
c1 int primary key,
c2 vector(3),
vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;
# Insert data into both tables
insert into t_regular values (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');
# Do NOT refresh - ChangeStream behind for t_vec
# Fork database with mixed tables
fork database db_async_src to db_async_fork;
call dbms_index_manager.refresh();
# Verify regular table is fully consistent (unaffected by async index issue)
select count(*) as fork_regular_cnt from db_async_fork.t_regular;
fork_regular_cnt
3
select * from db_async_fork.t_regular order by id;
id	name
1	Alice
2	Bob
3	Charlie
# Verify async vector table: direct count
select count(*) as fork_vec_total from db_async_fork.t_vec;
fork_vec_total
50
# Verify async vector table: approximate search
# EXPECTED after fix: 50 (equals fork_vec_total)
# BUG before fix: < 50
select count(*) as fork_vec_approx from (
select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 100
) t;
fork_vec_approx
50
drop database if exists db_async_src;
drop database if exists db_async_fork;
============================================
3. Control: Fork Database after full refresh
============================================
create database db_async_src;
use db_async_src;
create table t_vec(
c1 int primary key,
c2 vector(3),
vector index idx_vec(c2) with (distance=l2, type=hnsw, lib=vsag, sync_mode=async, ef_search=200)
) organization heap;
# Refresh BEFORE fork - ChangeStream fully caught up
call dbms_index_manager.refresh();
# Verify source consistency
select count(*) as src_total from t_vec;
src_total
20
select count(*) as src_approx from (
select c1 from t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 50
) t;
src_approx
20
# Fork after refresh
fork database db_async_src to db_async_fork;
# Fork should be fully consistent
select count(*) as fork_total from db_async_fork.t_vec;
fork_total
20
select count(*) as fork_approx from (
select c1 from db_async_fork.t_vec order by l2_distance(c2, '[0,0,0]') approximate limit 50
) t;
fork_approx
20
============================================
Cleanup
============================================
drop database if exists db_async_src;
drop database if exists db_async_fork;
alter system set ob_vector_memory_limit_percentage = 0;
