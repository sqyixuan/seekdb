##owner: fankun.fan
##owner group: 底层引擎部-轻量版
##description: Fork Table对行存主表+列存索引的处理测试
##tags: fork_table column_store index
##author: fankun.fan

--disable_warnings
drop database if exists db_fork_cs_idx;
--enable_warnings

connect (obsys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connection default;
create database db_fork_cs_idx;
use db_fork_cs_idx;

SET wait_timeout=30000000;
SET ob_trx_timeout = 100000000;
SET ob_query_timeout = 100000000;

--echo # 加速major freeze
--source mysql_test/test_suite/fork_table/include/quick_major.inc

--echo ============================================
--echo 1. 行存主表 + 列存索引 - 应当被拦截
--echo ============================================

drop table if exists t1;
drop table if exists t1_fork;

create table t1 (
    c1 int primary key,
    c2 int,
    c3 varchar(50)
) partition by range(c1) (
    partition p0 values less than (100),
    partition p1 values less than (200),
    partition p2 values less than (MAXVALUE)
);

create unique index idx_col on t1(c1) storing(c2, c3) with column group(each column);

--echo # 插入数据
insert into t1 values (1, 100, 'aaa'), (50, 200, 'bbb'), (101, 300, 'ccc'), (150, 400, 'ddd'), (201, 500, 'eee');

--echo # 触发major freeze确保数据落盘为SSTable
alter system major freeze;
--source mysql_test/test_suite/fork_table/include/wait_daily_merge.inc

--echo # Fork应该报错：索引带有列存
--error 1235
fork table t1 to t1_fork;

--echo ============================================
--echo 2. 行存主表 + 行存索引 - 应当成功
--echo ============================================

drop table if exists t2;
drop table if exists t2_fork;

create table t2 (
    c1 int primary key,
    c2 int,
    c3 varchar(50)
) partition by range(c1) (
    partition p0 values less than (100),
    partition p1 values less than (200),
    partition p2 values less than (MAXVALUE)
);

create unique index idx_row on t2(c1) storing(c2, c3);

insert into t2 values (1, 100, 'aaa'), (50, 200, 'bbb'), (101, 300, 'ccc'), (150, 400, 'ddd'), (201, 500, 'eee');

alter system major freeze;
--source mysql_test/test_suite/fork_table/include/wait_daily_merge.inc

--echo # Fork应该成功：索引是纯行存
fork table t2 to t2_fork;
--source mysql_test/test_suite/fork_table/include/wait_fork_table.inc

select count(*) as cnt from t2_fork;
select * from t2_fork order by c1;

--echo ============================================
--echo 3. 清理
--echo ============================================

drop table if exists t1;
drop table if exists t1_fork;
drop table if exists t2;
drop table if exists t2_fork;
drop database if exists db_fork_cs_idx;
